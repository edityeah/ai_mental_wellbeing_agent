# Production env template for the Next.js web app.
# Copy to .env.production.local and fill in real values, OR set these as
# project env vars in Vercel.

# Public Supabase config (browser uses these directly for auth).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# API base URL — point at your deployed FastAPI service.
NEXT_PUBLIC_API_URL=https://api.your-domain.com
