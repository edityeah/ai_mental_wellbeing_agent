# Production env template for the API service.
# Copy to .env.production and fill in real values, OR set these as
# secrets in your hosting platform (Fly secrets, Railway variables, etc).
# DO NOT commit the filled version.

# --- Database (Supabase managed Postgres or other Postgres host) -----------
# Use the connection-pool URL (port 6543) in production, not direct (5432),
# unless your host runs its own pgbouncer.
DATABASE_URL=postgresql+asyncpg://user:password@db.your-supabase-project.supabase.co:6543/postgres

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_COMPANION_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Supabase Auth ----------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- LiveKit (voice) --------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# --- Voice worker shared secret ---------------------------------------------
# Random 32+ char string the API and voice worker both know — used so the
# worker's heartbeat / session-end callbacks aren't impersonatable.
VOICE_WORKER_SECRET=replace-with-32-char-random-string

# --- Voice / cost guardrails ------------------------------------------------
DAILY_TEXT_MSG_CAP=50
DAILY_VOICE_SECONDS_CAP=600
PER_CALL_MAX_SECONDS=300
DAILY_VOICE_MINUTES_GLOBAL=500
DAILY_COST_CEILING_USD=20.0

# --- CORS -------------------------------------------------------------------
# Set in apps/api/app/main.py — update there to point at your prod web origin.
