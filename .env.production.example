# Production env file for the single-VM Docker Compose deployment.
#
# Copy to .env on the VM and fill in real values:
#   cp .env.production.example .env
#   nano .env
#
# DO NOT commit .env. It contains every secret your stack needs.

# ── Domains ────────────────────────────────────────────────────────
# These get baked into the web client bundle at build time (any change
# requires `docker compose build --no-cache web`).
NEXT_PUBLIC_API_URL=https://api.adityeah.ai

# CORS — comma-separated list of origins the API will accept.
CORS_ALLOWED_ORIGINS=https://wellbeing.adityeah.ai

# ── Database (Supabase managed Postgres) ──────────────────────────
# Use the TRANSACTION pooler (port 6543) for app traffic.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# ── Supabase Auth ─────────────────────────────────────────────────
SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<your-ref>.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_COMPANION_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# ── LiveKit (voice) ───────────────────────────────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=secret...

# ── STT / TTS ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=...
CARTESIA_API_KEY=...

# ── Voice worker internal shared secret ───────────────────────────
# Any random 32+ char string. The API and voice worker both need this.
VOICE_WORKER_SECRET=replace-with-32-char-random-string

# ── Guardrails ────────────────────────────────────────────────────
DAILY_TEXT_MSG_CAP=50
DAILY_VOICE_SECONDS_CAP=600
PER_CALL_MAX_SECONDS=300
DAILY_VOICE_MINUTES_GLOBAL=500
DAILY_COST_CEILING_USD=20.0
