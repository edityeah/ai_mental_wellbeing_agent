# Local dev environment file. Copy to apps/api/.env and fill in the
# `<placeholder>` values from your own accounts.
#
# This same set of values also goes into the root .env when running
# the production docker-compose.tunnel.yml — see .env.production.example
# and docs/DEPLOY.md.

# ── Database ──────────────────────────────────────────────────────
# Matches the local Postgres container in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://mwc:mwc_dev@localhost:5433/mwc

# ── Anthropic (Claude Sonnet 4.6 + Haiku 4.5) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-<your-key>
ANTHROPIC_COMPANION_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# ── Supabase (auth + managed Postgres in production) ──────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ<your-anon-key>
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── LiveKit Cloud (WebRTC for voice calling) ──────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=API<your-key>
LIVEKIT_API_SECRET=<your-secret>

# ── STT (Deepgram) + TTS (Cartesia) ───────────────────────────────
DEEPGRAM_API_KEY=<your-deepgram-key>
CARTESIA_API_KEY=<your-cartesia-key>

# ── Internal voice worker ↔ API shared secret ─────────────────────
# Any random 32+ char string. Used so the worker's heartbeat /
# session-end callbacks to the API can't be spoofed.
VOICE_WORKER_SECRET=<random-32-char-string>

# ── Cost + usage guardrails ───────────────────────────────────────
DAILY_TEXT_MSG_CAP=50
DAILY_VOICE_SECONDS_CAP=600
PER_CALL_MAX_SECONDS=300
DAILY_VOICE_MINUTES_GLOBAL=500
DAILY_COST_CEILING_USD=20

# ── Web app (NEXT_PUBLIC_* are baked into the client bundle) ──────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ<your-anon-key>
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Production-only (override at deploy time) ─────────────────────
# CORS_ALLOWED_ORIGINS=https://wellbeing.adityeah.ai
