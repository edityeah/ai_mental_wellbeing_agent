# Caddy v2 — reverse proxy + automatic TLS for the Wellbeing app.
#
# Caddy will request a Let's Encrypt cert for each domain the first time
# it sees a request, and renew automatically. No config changes needed
# on cert expiry — Caddy handles it.
#
# Prerequisite: the two domains below must point at this VM's public IP
# at the DNS level BEFORE Caddy starts, otherwise the HTTP-01 challenge
# fails and Caddy serves an untrusted cert.

# ── Web (Next.js) ───────────────────────────────────────────────────
wellbeing.adityeah.ai {
	encode zstd gzip

	# All requests proxied to the web container on the docker network.
	reverse_proxy web:3000 {
		# Pass through the original client IP / proto so the Next.js
		# app can log it correctly.
		header_up X-Real-IP {http.request.remote.host}
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.scheme}
	}

	# Long-lived HTTP responses (SSE) need a generous timeout — chat
	# replies can take 20+ seconds for the full assistant turn.
	# Default Caddy timeout is 0 (unlimited) but being explicit:
	# (no extra config needed; Caddy's default works.)

	# Reasonable security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the Server header so we don't advertise Caddy version
		-Server
	}
}

# ── API (FastAPI) ───────────────────────────────────────────────────
api.adityeah.ai {
	encode zstd gzip

	reverse_proxy api:8000 {
		header_up X-Real-IP {http.request.remote.host}
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Proto {http.request.scheme}

		# SSE: disable Caddy's response buffering so tokens stream
		# to the browser as soon as FastAPI emits them.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
